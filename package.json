{
  "name": "safespace-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node tests/run-tests.mjs",
    "test:legacy": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:validation": "vitest run",
    "test:typecheck": "tsc -p tsconfig.tests.json --pretty false",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "format:check": "prettier --check src",
    "format": "prettier --write src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.1.2",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
